datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique @default(uuid())
  passwordHash  String?   @default("hashed_password")
  apiKey        String    @unique @default(uuid())
  
  // Billing & Subscription
  plan          String    @default("FREE")
  planStatus    String    @default("ACTIVE")
  planStartedAt DateTime?
  planExpiresAt DateTime?

  accounts      Account[]
  sessions      Session[]
  runs          Run[]
  agents        Agent[]
  orders        Order[]
  subscriptions Subscription[]
  alertWebhooks AlertWebhook[]
  projectBudgets ProjectBudget[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Agent {
  id          String   @id @default(uuid())
  userId      String
  name        String
  framework   String   @default("Custom")
  modelFamily String   @default("Claude 3.5 Sonnet")
  description String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        Run[]
  createdAt   DateTime @default(now())
}

model Run {
  id                String   @id @default(uuid())
  userId            String
  agentId           String?
  title             String
  description       String?
  status            String   // completed, failed, running
  modelFamily       String   @default("Claude 3.5 Sonnet")
  
  // Telemetry Metrics
  wallClockMs       Int
  totalTokens       Int
  promptTokens      Int      @default(0)
  completionTokens  Int      @default(0)
  actionVelocityTps Float
  totalCostUsd      Float
  totalToolCalls    Int      @default(0)
  dagDepth          Int      @default(1)
  
  // Organization Metadata
  project           String   @default("default")
  env               String   @default("production")

  // Extended Observability Fields
  input             String?
  output            String?
  error             String?
  errorType         String?
  sessionId         String?
  endUserId         String?
  qualityScore      Int?
  version           String?
  promptVersion     String?
  gitCommit         String?
  isDemo            Boolean  @default(false)
  shareToken        String?  @unique

  user              User     @relation(fields: [userId], references: [id])
  agent             Agent?   @relation(fields: [agentId], references: [id])
  spans             Span[]
  detections        Detection[]
  investigation     Investigation?
  evaluation        Evaluation?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Span {
  id                String   @id @default(uuid())
  runId             String
  spanId            String
  parentSpanId      String?
  name              String
  type              String
  status            String   @default("SUCCESS")
  latencyMs         Int
  tokens            Int      @default(0)
  cost              Float    @default(0.0)
  rawInput          String?
  rawOutput         String?
  diagnosticTag     String?
  diagnosticSummary String?
  
  model             String?
  provider          String?
  inputTokens       Int?     @default(0)
  outputTokens      Int?     @default(0)
  errorType         String?
  errorMessage      String?
  retryCount        Int      @default(0)
  metadata          String?
  attributes        String?

  run               Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
}

model Detection {
  id        String   @id @default(uuid())
  runId     String
  type      String
  severity  String
  message   String
  metadata  String?
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Investigation {
  id             String   @id @default(uuid())
  runId          String   @unique
  rootCause      String
  confidence     Int
  evidence       String?
  recommendation String?
  impact         String?
  observed       String?
  inferred       String?
  suggested      String?
  status         String?
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Evaluation {
  id                 String   @id @default(uuid())
  runId              String   @unique
  score              Int?     // 0-100 overall score
  thumbs             String?  // UP, DOWN
  hallucinationScore Int?     // 0-100
  faithfulnessScore  Int?     // 0-100
  toxicityScore      Int?     // 0-100
  notes              String?
  evaluator          String   @default("Human Reviewer")
  run                Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AlertWebhook {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        String   // SLACK, DISCORD, GENERIC_HTTP
  url         String
  triggers    String   @default("CRITICAL_DETECTIONS,HIGH_COST,ERROR_SPIKE")
  minCostUsd  Float?   @default(0.50)
  minSeverity String   @default("CRITICAL")
  enabled     Boolean  @default(true)
  lastFiredAt DateTime?
  failureCount Int     @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectBudget {
  id                 String   @id @default(uuid())
  userId             String
  project            String   @default("default")
  monthlyLimitUsd    Float    @default(50.0)
  alertThresholdPct  Int      @default(80)
  circuitBreaker     Boolean  @default(false)
  currentSpendUsd    Float    @default(0.0)
  currency           String   @default("USD")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Order {
  id              String    @id @default(uuid())
  userId          String
  plan            String    // PRO, TEAM, ENTERPRISE
  amount          Int       // in paisa (e.g. 199900)
  currency        String    @default("INR")
  status          String    @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED, EXPIRED
  provider        String    @default("RAZORPAY")
  merchantOrderId String    @unique
  providerOrderId String?
  paymentDetails  String?
  errorMessage    String?
  paidAt          DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  plan            String   // PRO, TEAM, ENTERPRISE
  status          String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  billingCycle    String   @default("MONTHLY")
  amount          Int      // in paisa
  currency        String   @default("INR")
  merchantOrderId String?
  startDate       DateTime @default(now())
  endDate         DateTime
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
