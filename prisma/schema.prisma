datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique @default(uuid())
  passwordHash  String?   @default("hashed_password")
  apiKey        String    @unique @default(uuid())
  accounts      Account[]
  sessions      Session[]
  runs          Run[]
  agents        Agent[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Agent {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  framework   String   @default("Custom")
  modelFamily String
  runs        Run[]
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Run {
  id                String   @id @default(uuid())
  userId            String
  agentId           String?
  title             String
  description       String?
  status            String   @default("completed")
  modelFamily       String   @default("Claude 3.5 Sonnet")
  
  // Telemetry Metrics
  wallClockMs       Int
  totalTokens       Int
  promptTokens      Int      @default(0)
  completionTokens  Int      @default(0)
  actionVelocityTps Float
  totalCostUsd      Float
  totalToolCalls    Int      @default(0)
  dagDepth          Int      @default(1)
  
  // Organization Metadata
  project           String   @default("default")
  env               String   @default("production")

  user              User     @relation(fields: [userId], references: [id])
  agent             Agent?   @relation(fields: [agentId], references: [id])
  spans             Span[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Span {
  id                String   @id @default(uuid())
  runId             String
  spanId            String
  parentSpanId      String?
  name              String
  type              String
  status            String   @default("SUCCESS")
  latencyMs         Int
  tokens            Int      @default(0)
  cost              Float    @default(0.0)
  rawInput          String?
  rawOutput         String?
  diagnosticTag     String?
  diagnosticSummary String?
  run               Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
}
