# PathFlow Environment Variables Template

# Custom Domain Configuration
NEXT_PUBLIC_MARKETING_URL="https://thepathflow.online"
NEXT_PUBLIC_APP_URL="https://thepathflow.online/app"

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js Configuration
AUTH_SECRET="your_generated_random_auth_secret_here"
NEXTAUTH_URL="https://thepathflow.online/app"

# Google Cloud OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# PathFlow SDK Telemetry Defaults
PATHFLOW_API_KEY="pf_live_secret_key"
PATHFLOW_ENDPOINT="https://thepathflow.online/app/api/v1"
